{
    "name": "server",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "tsdown",
        "clean": "git clean -xdf .cache .turbo node_modules dist -e .env -e .env.*",
        "dev": "NODE_ENV=development urls sh -c 'tsx src/env.ts && tsx watch --import ./src/instrument.ts ./src/index.ts'",
        "start": "NODE_ENV=production node --import ./dist/instrument.mjs --enable-source-maps dist/index.mjs",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.4",
        "@orpc/json-schema": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/server": "catalog:",
        "@orpc/zod": "catalog:",
        "@shipkit/auth": "workspace:*",
        "@shipkit/db": "workspace:*",
        "@shipkit/env": "workspace:*",
        "@shipkit/telemetry": "workspace:*",
        "hono": "^4.8.2",
        "rate-limiter-flexible": "^11.1.0"
    },
    "devDependencies": {
        "tsdown": "^0.21.9",
        "tsx": "^4.23.1"
    }
}
