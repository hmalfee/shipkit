{
    "name": "server",
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "build": "tsdown",
        "clean": "git clean -xdf .cache .turbo node_modules dist -e .env -e .env.*",
        "dev": "NODE_ENV=development ports exec -- sh -c 'tsx src/env.ts && tsx watch --import ./src/instrument.ts ./src/index.ts'",
        "start": "NODE_ENV=production ports exec -- sh -c 'node dist/env.mjs && node --import ./dist/instrument.mjs --enable-source-maps dist/index.mjs'",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@hono/node-server": "^1.14.4",
        "@mento-mark/auth": "workspace:*",
        "@mento-mark/db": "workspace:*",
        "@mento-mark/env": "workspace:*",
        "@mento-mark/telemetry": "workspace:*",
        "@orpc/json-schema": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/server": "catalog:",
        "@orpc/zod": "catalog:",
        "hono": "^4.8.2",
        "rate-limiter-flexible": "^11.1.0",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@mento-mark/ports": "workspace:*",
        "tsdown": "^0.21.9"
    }
}
