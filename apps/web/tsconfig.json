{
    "extends": "@mento-mark/ts-config/base",
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["dom", "dom.iterable", "esnext"],
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "src",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts",
        "*.config.ts"
    ]
}
