{
    "name": "{{#if (isApp type)}}{{name}}{{else}}@mento-mark/{{name}}{{/if}}",
    "type": "module",
{{#if (isApp type)}}
    "scripts": {
        "typecheck": "tsc",
        "dev": "node --watch src/index.ts",
        "start": "node src/index.ts"
    }
{{else}}
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "typecheck": "tsc"
    }
{{/if}}
}
