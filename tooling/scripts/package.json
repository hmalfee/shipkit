{
    "name": "@shipkit/scripts",
    "private": true,
    "type": "module",
    "bin": {
        "docker-build": "./bin/docker-build/index.js",
        "dokploy": "./bin/dokploy/index.js",
        "local-manager": "./bin/local-manager/index.js",
        "next-standalone-postbuild": "./bin/next-standalone-postbuild.js",
        "run-on-staged": "./bin/run-on-staged/index.js",
        "sandbox": "./bin/sandbox/index.js"
    },
    "scripts": {
        "generate:dokploy": "openapi-typescript https://raw.githubusercontent.com/Dokploy/sdk/main/openapi.json -o ./lib/dokploy/schema.d.ts",
        "postinstall": "chmod +x ./bin/*.js ./bin/*/index.js",
        "pretypecheck": "pnpm generate:dokploy",
        "typecheck": "tsc"
    },
    "dependencies": {
        "micromatch": "^4.0.8",
        "openapi-fetch": "^0.17.0",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@shipkit/ts-config": "workspace:*",
        "openapi-typescript": "^7.13.0",
        "openapi-typescript-helpers": "^0.1.0"
    }
}
