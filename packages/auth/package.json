{
    "name": "@mento-mark/auth",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./orpc": "./src/orpc.ts"
    },
    "scripts": {
        "auth:generate": "SKIP_ENV_VALIDATION=1 pnpx @better-auth/cli@latest generate --config ./src/cli.ts --output ./src/auth.temp.ts --yes",
        "clean": "git clean -xdf .cache .turbo node_modules src/auth.temp.ts -e .env -e .env.*",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@better-auth/redis-storage": "^1.6.11",
        "better-auth": "catalog:"
    },
    "devDependencies": {
        "@mento-mark/db": "workspace:*",
        "@mento-mark/ts-config": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "typescript": "catalog:"
    }
}
