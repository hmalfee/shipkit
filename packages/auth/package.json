{
    "name": "@shipkit/auth",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./orpc": "./src/orpc.ts"
    },
    "scripts": {
        "clean": "git clean -xdf .cache .turbo node_modules auth-schema.ts -e .env -e .env.*",
        "schema:gen": "pnpm dlx auth@latest generate --yes",
        "postschema:gen": "prettier auth-schema.ts --write --ignore-path .prettierignore",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@better-auth/redis-storage": "^1.6.11",
        "better-auth": "catalog:"
    },
    "devDependencies": {
        "@shipkit/db": "workspace:*",
        "@shipkit/ts-config": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "typescript": "catalog:"
    }
}
