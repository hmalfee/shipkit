{
    "name": "@mento-mark/db",
    "type": "module",
    "exports": {
        "./pg": "./src/pg/index.ts",
        "./pg/schema": "./src/pg/schema/index.ts",
        "./redis": "./src/redis/index.ts"
    },
    "scripts": {
        "clean": "git clean -xdf .cache .turbo node_modules -e .env -e .env.*",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "predev": "ports compose up -d --wait",
        "dev": "pnpm db:push",
        "studio:postgres": "drizzle-kit studio",
        "studio:redis": "pnpx redis-commander",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@mento-mark/env": "workspace:*",
        "@mento-mark/telemetry": "workspace:*",
        "drizzle-orm": "^0.45.1",
        "ioredis": "^5.10.1",
        "pg": "^8.17.1"
    },
    "devDependencies": {
        "@types/pg": "^8.16.0",
        "drizzle-kit": "^0.31.8"
    }
}
