{
    "name": "@mento-mark/telemetry",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./logger": "./src/logger/index.ts",
        "./tracing": "./src/tracing/spans.ts",
        "./middleware/*": "./src/middleware/*.ts"
    },
    "scripts": {
        "clean": "git clean -xdf .cache .turbo node_modules -e .env -e .env.*",
        "dev": "ports exec docker compose up -d",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@opentelemetry/api": "catalog:",
        "@opentelemetry/core": "^2.7.1",
        "@opentelemetry/exporter-logs-otlp-proto": "^0.217.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.217.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.217.0",
        "@opentelemetry/instrumentation-http": "^0.217.0",
        "@opentelemetry/instrumentation-ioredis": "^0.65.0",
        "@opentelemetry/instrumentation-pg": "^0.69.0",
        "@opentelemetry/instrumentation-runtime-node": "^0.31.0",
        "@opentelemetry/instrumentation-undici": "^0.28.0",
        "@opentelemetry/resources": "^2.7.1",
        "@opentelemetry/sdk-logs": "^0.217.0",
        "@opentelemetry/sdk-metrics": "^2.7.1",
        "@opentelemetry/sdk-node": "^0.217.0",
        "@opentelemetry/sdk-trace-base": "^2.7.1",
        "@opentelemetry/semantic-conventions": "^1.40.0",
        "@opentelemetry/winston-transport": "^0.28.0",
        "winston": "^3.17.0"
    },
    "peerDependencies": {
        "hono": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "hono": {
            "optional": true
        }
    }
}
