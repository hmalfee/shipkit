{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**",
                "next-env.d.ts"
            ]
        },
        "typecheck": {
            "outputs": [".cache/tsbuildinfo.json"]
        },
        "knip": {
            "outputs": []
        },
        "dev": {
            "dependsOn": ["^dev"],
            "cache": false,
            "persistent": true
        },
        "predev": {
            "cache": false
        },
        "start": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "clean": {
            "cache": false
        },
        "//#clean": {
            "cache": false
        }
    }
}
