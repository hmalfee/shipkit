{
    "name": "shipkit",
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*",
        "tooling/*"
    ],
    "scripts": {
        "build": "turbo build",
        "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run knip",
        "clean": "git clean -xdf .cache .turbo node_modules -e .env -e .env.*",
        "clean:full": "turbo run clean",
        "dev": "turbo dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "generate": "turbo gen create",
        "knip": "SKIP_ENV_VALIDATION=1 knip",
        "lint": "oxlint . --deny-warnings",
        "prepare": "run-on-staged --setup && setup-commitlint",
        "typecheck": "turbo run typecheck"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "prettier": "@shipkit/prettier-config",
    "dependencies": {
        "@shipkit/shared": "workspace:*",
        "@shipkit/telemetry": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@shipkit/oxlint-config": "workspace:*",
        "@shipkit/prettier-config": "workspace:*",
        "@shipkit/scripts": "workspace:*",
        "@shipkit/ts-config": "workspace:*",
        "@turbo/gen": "^2.9.8",
        "@types/node": "^22.13.14",
        "knip": "^6.12.0",
        "oxlint": "1.62.0",
        "prettier": "^3.8.3",
        "turbo": "^2.8.12",
        "typescript": "catalog:"
    },
    "packageManager": "pnpm@10.32.1",
    "engines": {
        "node": "22.x",
        "pnpm": "10.x"
    },
    "run-on-staged": {
        "checks": [
            {
                "name": "Format",
                "command": "pnpm run format:check"
            },
            {
                "name": "Lint",
                "command": "pnpm run lint"
            },
            {
                "name": "Typecheck",
                "command": "pnpm run typecheck"
            },
            {
                "name": "Knip",
                "command": "pnpm run knip"
            }
        ]
    }
}
