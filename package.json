{
    "name": "shipkit",
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "check": "turbo run format:check lint typecheck knip",
        "clean": "git clean -xdf .cache .turbo node_modules -e .env -e .env.*",
        "clean:full": "turbo run clean",
        "dev": "turbo run dev",
        "format": "prettier --cache --write .",
        "format:check": "prettier --cache --check .",
        "generate": "turbo gen create",
        "knip": "SKIP_ENV_VALIDATION=1 knip",
        "lint": "oxlint . --deny-warnings",
        "prepare": "husky",
        "preview": "turbo run preview",
        "typecheck": "turbo run typecheck"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "prettier": "@shipkit/prettier-config",
    "dependencies": {
        "@shipkit/shared": "workspace:*",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@shipkit/oxlint-config": "workspace:*",
        "@shipkit/prettier-config": "workspace:*",
        "@shipkit/scripts": "workspace:*",
        "@shipkit/ts-config": "workspace:*",
        "@turbo/gen": "^2.9.8",
        "@types/node": "^22.13.14",
        "husky": "^9.1.7",
        "knip": "^6.12.0",
        "oxlint": "1.62.0",
        "prettier": "^3.8.3",
        "turbo": "^2.8.12",
        "typescript": "catalog:"
    },
    "packageManager": "pnpm@11.15.1",
    "engines": {
        "node": "24.x",
        "pnpm": "11.x"
    },
    "run-on-staged": [
        "pnpm install",
        "turbo db:generate",
        "turbo run format:check",
        "turbo run lint",
        "turbo run typecheck",
        "turbo run knip"
    ]
}
