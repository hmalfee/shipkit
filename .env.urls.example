# Commented means that the app can run without it.

# Ports

WEB_PORT=4000 # Grafana usually runs on 3000, so we use 4000 for the web app
SERVER_PORT=4001

# Bases

# exported as format: INTERNAL_<APP>_URL=http://localhost:<<APP>_PORT>
# example: INTERNAL_WEB_URL=http://localhost:4000
# default: INTERNAL_BASE=http://localhost
# INTERNAL_BASE=http://localhost

# exported as format: <APP>_URL=http://<YOUR_IP>.sslip.io:<<APP>_PORT>
# example: WEB_URL=http://192.168.x.xxx.sslip.io:4000
# {IP} is replaced at runtime with the machine's LAN IP address
# You can avoid `.sslip.io` but direct IP address doesn't work on Google OAuth2 redirects
# default: PUBLIC_BASE=http://localhost
# PUBLIC_BASE=http://{IP}.sslip.io
